# App runtime (NOSUPERUSER NOBYPASSRLS)
DATABASE_URL=postgresql+asyncpg://aegis_app:CHANGE_ME_APP@localhost:5433/aegis_soar

# Migrations only (aegis_owner - NEVER used by aegis-api)
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://aegis_owner:CHANGE_ME_OWNER@localhost:5433/aegis_soar

# Cryptographic keys (generate locally; never commit real values)
AEGIS_JWT_PRIVATE_KEY_PEM=CHANGE_ME_ED25519_PRIVATE_KEY
AEGIS_JWT_PUBLIC_KEY_PEM=CHANGE_ME_ED25519_PUBLIC_KEY
AEGIS_MFA_KEK_B64=CHANGE_ME_32_BYTE_BASE64_AES256_GCM_KEY

# Security defaults
STALE_EXECUTION_TIMEOUT_SECONDS=60
